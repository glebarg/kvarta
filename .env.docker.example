# Set your real domain on the server before enabling the production profile.
DOMAIN=coffee.example.com

# Allowed frontend origins. Use your real HTTPS domain on the server.
FRONTEND_ORIGINS=https://coffee.example.com

# Host port for local testing only; local site will be http://127.0.0.1:8080.
HTTP_PORT=8080

# Optional: Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_TIMEOUT=5
